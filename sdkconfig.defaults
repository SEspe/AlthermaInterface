# Common defaults for all targets. Target-specific values live in
# sdkconfig.defaults.esp32 (applied automatically by idf.py after this file).
CONFIG_PARTITION_TABLE_CUSTOM=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# OTA rollback: an image that never confirms itself valid via
# esp_ota_mark_app_valid_cancel_rollback() gets rolled back to the previous
# slot on the next boot, so a bad OTA upload can't brick a unit that lives
# inside a heat pump enclosure.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The HP query loop must not be starved by WiFi/MQTT reconnect work.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

# MQTT (esp-mqtt) replaces PubSubClient. The ATTR payload is one large JSON
# object (upstream MAX_MSG_SIZE 7120), so the outbox buffer must clear it.
# MQTT_BUFFER_SIZE depends on MQTT_USE_CUSTOM_CONFIG; without the enable below
# the size line is silently dropped and the buffer stays at the 1024 default -
# which the ATTR payload would not fit. idf.py reports this as "Disabled
# Symbols/Choices With User-Set Value", easy to scroll past.
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_BUFFER_SIZE=8192

# httpd tuning for the on-device config UI (replaces compile-time setup.h).
CONFIG_HTTPD_MAX_REQ_HDR_LEN=4096
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_LWIP_MAX_SOCKETS=16

# HTTPS OTA from GitHub releases: the device downloads a release asset itself
# over TLS, because the browser cannot - the GitHub API sends CORS "*" so the
# release LIST is fetchable from the page, but the asset host sends no CORS
# header at all. The bundle validates GitHub's certificate; dynamic buffers keep
# the TLS heap peak small.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# Needed whenever the chain's root is cross-signed. Without it the bundle
# callback returns a fatal error with NO cert-verify flag set, which surfaces as
# a bare connect failure and reads exactly like a network problem. Costs ~700 B.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# Power management, for the configurable power profiles (FSD section 3.2). The
# board is fed from the heat pump's internal 5 V regulator, which was never
# sized for an ESP32, so the CPU frequency is selectable at runtime.
#
# esp_pm_configure() is the only supported way to change CPU frequency at
# runtime, and it needs this symbol. The profiles always set min_freq == max_freq
# so no dynamic scaling actually occurs: 80, 160 and 240 MHz are all PLL-derived
# and leave APB at 80 MHz, which is what keeps the X10A UART's 9600 8E1 baud
# divisor correct. A future profile that scales below 80 MHz would drop APB to
# the XTAL frequency and MUST move the UART to UART_SCLK_REF_TICK first.
CONFIG_PM_ENABLE=y

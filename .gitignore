# ESP-IDF build artifacts
build/
build_*/
*.bin
*.elf
*.map
*.hex

# ESP-IDF generated files (regenerated from sdkconfig.defaults / idf_component.yml)
sdkconfig
sdkconfig.old
dependencies.lock
managed_components/

# Upstream ESPAltherma clone — reference input only, not part of this repo.
# Re-fetch with: git clone https://github.com/raomin/ESPAltherma.git upstream-ESPAltherma
upstream-ESPAltherma/

# Local credentials / per-machine config (never commit)
main/secrets.h

# IDE files
.vscode/
*.code-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.pyc

# Live captures from the reference unit. Ignored while a run is in progress so
# a half-written file cannot be swept into a commit by "git add -A"; a finished
# capture that is worth keeping as evidence goes in with "git add -f".
captures/

# Local-only working documents: never pushed. CLAUDE.md is the agent/build
# working reference and SESSION_NOTES.md is the session log; both stay on this
# machine.
CLAUDE.md
SESSION_NOTES.md

#pragma once

// Copy to secrets.h and fill in. secrets.h is git-ignored; this template is not.
// Phase 6 moves all of this to NVS + the web UI, and this file goes away.

#define ALT_WIFI_SSID     "your-ssid"
#define ALT_WIFI_PASSWORD "your-password"

// Broker URI: mqtt://host:port for plain TCP, mqtts://host:port for TLS.
#define ALT_MQTT_URI      "mqtt://192.168.1.4:1883"
#define ALT_MQTT_USERNAME ""
#define ALT_MQTT_PASSWORD ""

// Optional static IP. Uncomment all four to bypass DHCP entirely - useful when
// the AP associates the client but never answers its DHCP DISCOVER.
